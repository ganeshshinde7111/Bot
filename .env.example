# Copy to .env and fill in. Never commit the real .env file.

# --- Webhook listener (TradingView / MT5 -> signal store) ---
WEBHOOK_SHARED_SECRET=changeme-generate-a-long-random-string

# --- Active broker: "dhan" (default) or "kite" (fallback) ---
ACTIVE_BROKER=dhan

# --- DhanHQ (Trading APIs free; market-data APIs are a SEPARATE Dhan subscription) ---
# Generate from the Dhan web console: Profile > DhanHQ Trading APIs.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# --- Zerodha Kite Connect (kept as a fallback; set ACTIVE_BROKER=kite to use) ---
KITE_API_KEY=
KITE_API_SECRET=
# Access tokens expire every trading day -- see docs/DEPLOYMENT.md for the
# daily refresh flow (cannot be fully non-interactive due to Kite's login
# requirement; automate the parts that can be automated).
KITE_ACCESS_TOKEN=

# --- News sentiment (optional; degrades gracefully if unset) ---
NEWS_API_KEY=

# --- Safety gates (all enforced in code, not just prompt-level) ---
LIVE_TRADING_ENABLED=false
MAX_ORDER_VALUE_INR=25000
MAX_DAILY_LOSS_PCT=2.0
MAX_POSITION_RISK_PCT=1.0
MAX_OPEN_POSITIONS=5

# --- MCP transport (stdio for local Claude Desktop, streamable-http for VPS) ---
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8000
