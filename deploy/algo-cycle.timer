[Unit]
Description=Run the AI algo-trading decision cycle every 15 minutes

[Timer]
# The script itself skips anything outside NSE hours (Mon-Fri 09:15-15:30 IST,
# computed in Asia/Kolkata regardless of the server's timezone), so this can
# tick around the clock harmlessly.
OnCalendar=*:0/15
Persistent=false
Unit=algo-cycle.service

[Install]
WantedBy=timers.target
